# ============================================================
# T-RAG Pipeline Configuration
# ============================================================
TORCH_NVML_BASED_CUDA_CHECK="0"
PYTORCH_NVML_BASED_CUDA_CHECK="0"

# LLM Local — Các tùy chọn Model từ nhỏ đến lớn để chạy Benchmark:
# Lưu ý: Hiện tại phân vùng MIG là 20GB VRAM. Khi chuyển sang bản 40GB, có thể mở các model lớn hơn.

# [Tùy chọn 1] VRAM: ~15GB (Phù hợp cho GPU 20GB)
# LOCAL_LLM_MODEL="Qwen/Qwen2.5-7B-Instruct"

# [Tùy chọn 2] VRAM: ~16GB (Phù hợp cho GPU 20GB, cần HuggingFace Token)
# LOCAL_LLM_MODEL="meta-llama/Meta-Llama-3.1-8B-Instruct"

# [Tùy chọn 3] VRAM: ~9GB (14B lượng tử hóa 4-bit, chạy cực tốt trên 20GB VRAM)
# LOCAL_LLM_MODEL="Qwen/Qwen2.5-14B-Instruct-AWQ"

# [Tùy chọn 4] VRAM: ~28GB (Phù hợp cho GPU 40GB/80GB)
LOCAL_LLM_MODEL="Qwen/Qwen2.5-14B-Instruct"

# [Tùy chọn 5] VRAM: ~64GB (Phù hợp cho GPU 80GB)
# LOCAL_LLM_MODEL="Qwen/Qwen2.5-32B-Instruct"

# vLLM: giới hạn VRAM để tránh OOM khi chạy song song với Reranker (Nên để 0.8 cho 20GB)
VLLM_GPU_MEMORY_UTILIZATION="0.8"

# Cross-Source Entity Propagation (CSEP)
# "True"  = kích hoạt cho TOÀN BỘ câu hỏi (mặc định)
# "False" = chỉ kích hoạt khi Router trả về >= 2 nguồn có P >= tau
ENABLE_CSEP_FOR_ALL="True"

# Reranker
RERANKER_MODEL="cross-encoder/ms-marco-MiniLM-L-6-v2"
# Ngưỡng cắt: docs có cross-encoder score < này sẽ bị loại
# Đặt "0.0" để tắt filtering (chỉ rerank, không cắt)
RERANKER_THRESHOLD="0.0"

# RAG Retrieval Hyperparameters
RAG_DB_URI="data/lancedb"
PSR_MODEL_DIR="models/psr_v2"
EMBEDDING_MODEL="BAAI/bge-large-en-v1.5"
# Ngưỡng xác suất để kích hoạt shard (0.0 -> 1.0)
RAG_TAU="0.15"
# Source Bias Factor trong công thức SW-RRF
RAG_GAMMA="2.0"
# Hằng số k trong Reciprocal Rank Fusion
RAG_K_RRF="60"
# Số docs lấy ra ở mỗi query trước khi Reranker lọc
RAG_TOP_K_RETRIEVE="20"
# Số docs cuối cùng đưa vào LLM (sau Reranker)
RAG_TOP_K_FINAL="5"

# Local LLM Judge
JUDGE_LLM_MODEL="Qwen/Qwen2.5-14B-Instruct"
