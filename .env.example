# ============================================================
# T-RAG Pipeline Configuration — Template
# Copy this file to .env and fill in appropriate values
# ============================================================

# LLM Local model (HuggingFace model ID)
LOCAL_LLM_MODEL="meta-llama/Meta-Llama-3.1-8B-Instruct"
# LOCAL_LLM_MODEL="Qwen/Qwen2.5-14B-Instruct"
VLLM_GPU_MEMORY_UTILIZATION="0.8"

# CSEP Toggle
ENABLE_CSEP_FOR_ALL="True"

# Reranker
RERANKER_MODEL="cross-encoder/ms-marco-MiniLM-L-6-v2"
RERANKER_THRESHOLD="0.0"

# RAG Retrieval Hyperparameters
RAG_DB_URI="data/lancedb"
PSR_MODEL_DIR="models/psr_v2"
EMBEDDING_MODEL="BAAI/bge-large-en-v1.5"
RAG_TAU="0.15"
RAG_GAMMA="2.0"
RAG_K_RRF="60"
RAG_TOP_K_RETRIEVE="20"
RAG_TOP_K_FINAL="5"

# Hybrid Search Toggle (Vector + FTS)
RAG_HYBRID_SEARCH="True"
RAG_DENSE_WEIGHT="0.3"
RAG_SPARSE_WEIGHT="0.7"
